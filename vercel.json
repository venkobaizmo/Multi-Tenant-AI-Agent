{
  "framework": "nextjs",
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "functions": {
    "src/app/api/**": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/api/widget/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "false" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" }
      ]
    }
  ]
}
